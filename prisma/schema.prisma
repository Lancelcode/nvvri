generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Nursery {
  id          String   @id @default(cuid())
  name        String
  area        String
  postcode    String
  description String
  ofsted      String
  price       Int
  hours       String
  ageRange    String
  minAge      Float    @default(0)
  maxAge      Float    @default(5)
  rating      Float
  reviews     Int
  spaces      Int
  tags        String[]
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}